# =============================================================================
# Enterprise Legacy Assistant — plantilla de variables de entorno
#
# Uso:
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
#
# Reglas:
#   * Este archivo SÍ se versiona. El archivo .env NUNCA se versiona.
#   * Las variables del sistema operativo tienen prioridad sobre este archivo.
#   * Un valor vacío se interpreta como "no definido" (ENV_IGNORE_EMPTY).
#   * Ninguna credencial debe escribirse en el código ni en la documentación.
# =============================================================================

# --- Aplicación y servidor ---------------------------------------------------
APP_NAME=Enterprise Legacy Assistant
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Proveedor de IA ---------------------------------------------------------
# Valores admitidos: azure_openai (primario) | openai (fallback)
AI_PROVIDER=azure_openai

# -----------------------------------------------------------------------------
# Azure OpenAI — API v1 (sin api-version)
# El endpoint NO incluye /openai/v1: se construye en el cliente. Debe ser https,
# sin ruta, sin query y sin fragmento.
# Los deployments se invocan por NOMBRE DE DEPLOYMENT, no por nombre de modelo.
# Los marcadores REPLACE_ME de esta plantilla son rechazados al arrancar: el
# servicio no arranca hasta que se sustituyan por valores reales.
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://REPLACE-ME.openai.azure.com
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -----------------------------------------------------------------------------
# OpenAI directo — solo se usa si AI_PROVIDER=openai (plan de contingencia).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small

# --- Parámetros del modelo ---------------------------------------------------
# LLM_TEMPERATURE vacío = el parámetro NO se envía al proveedor. Es lo correcto
# para la familia gpt-5*, que puede rechazar `temperature`.
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=3
AGENT_RECURSION_LIMIT=5

# --- Pipeline RAG ------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_RESULTS=3
SIMILARITY_THRESHOLD=0.70
COLLECTION_NAME=legacy_docs
# Métrica de distancia. `cosine` es obligatoria para que SIMILARITY_THRESHOLD
# tenga significado. No la cambies sin recalibrar el umbral.
VECTOR_STORE_SPACE=cosine

# --- Rutas y persistencia ----------------------------------------------------
# Raíz contra la que se resuelven todas las rutas relativas. Si se omite, es la
# raíz del repositorio. No es necesario definirla salvo en despliegues con otro
# layout; si se define relativa, se resuelve contra la raíz del proyecto.
# BASE_DIR=

DATA_DIR=data
VECTOR_STORE_PATH=data/vectorstore
AUDIT_LOG_PATH=data/audit/audit.jsonl
